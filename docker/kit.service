[Unit]
Description=ERC8415 institutional API
After=network-online.target
[Service]
User=erc8415
Group=erc8415
WorkingDirectory=/opt/erc8415-kit
EnvironmentFile=/etc/erc8415-kit/environment
ExecStart=/opt/erc8415-kit/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8415
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/erc8415-kit
UMask=0077
[Install]
WantedBy=multi-user.target
